# Spaceship Station Visualizer - Environment Configuration
# Copy this file to backend/.env and adjust values as needed

# Use mock data instead of live Docker API (true for testing, false for production)
MOCK_MODE=true

# Ollama server URL for AI features
OLLAMA_HOST=http://localhost:11434

# Default model for AI queries
OLLAMA_MODEL=neural-chat

# qBittorrent WebUI URL
QBITTORRENT_HOST=http://localhost:8080

# FastAPI server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# WebSocket broadcast interval (seconds)
BROADCAST_INTERVAL=2.0

# Log level (debug, info, warning, error)
LOG_LEVEL=info
