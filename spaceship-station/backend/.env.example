# Spaceship Station Visualizer - Environment Configuration
# Copy this file to backend/.env and adjust values as needed

# ============================================================================
# Core Settings
# ============================================================================

# Mock mode - set to 'false' to connect to live Docker daemon
# Recommended: Keep 'true' during development
MOCK_MODE=true

# Application environment
DEBUG=false
LOG_LEVEL=info

# ============================================================================
# Feature Toggles
# ============================================================================

# AI Core Integration
# WARNING: Requires significant GPU/VRAM (8GB+ recommended)
# Current hardware: GTX 1070 (4GB) may struggle with real-time inference
# DISABLED BY DEFAULT - Set to 'true' only if you have sufficient VRAM
ENABLE_AI=false

# Discord Bot Integration (optional)
# Leave empty to disable Discord features
# Get token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# ============================================================================
# System Services Configuration
# ============================================================================

# Docker daemon (only used when MOCK_MODE=false)
DOCKER_SOCKET=/var/run/docker.sock

# qBittorrent API (torrent monitoring)
QBITTORRENT_HOST=http://localhost:8080

# Ollama AI Service (only used when ENABLE_AI=true)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# ============================================================================
# Server Configuration
# ============================================================================

# FastAPI server host and port
SERVER_HOST=0.0.0.0
SERVER_PORT=0420

# WebSocket broadcast interval (seconds)
BROADCAST_INTERVAL=2

# ============================================================================
# Discord Configuration (if DISCORD_BOT_TOKEN is set)
# ============================================================================

# Channel IDs for bot notifications (enable developer mode in Discord)
DISCORD_CHANNEL_NOTIFICATIONS=
DISCORD_CHANNEL_APPROVALS=
DISCORD_CHANNEL_STATUS=

# ============================================================================
# Hardware Notes
# ============================================================================
# 
# System Specs:
# - GPU: GTX 1070 (4GB VRAM)
# - CPU: Ryzen 7 3700X
# - RAM: 46GB Total
#
# Recommendations:
# 1. Keep MOCK_MODE=true for development/testing
# 2. Keep ENABLE_AI=false - insufficient VRAM for Ollama
# 3. Use Discord bot for server control (recommended alternative to AI)
# 4. Monitor system resources during operations
#
# To enable real monitoring (requires Docker):
# 1. Set MOCK_MODE=false
# 2. Configure Docker socket path
# 3. Ensure Docker daemon is accessible
# 4. Start the application
#
# For Discord integration:
# 1. Create a Discord app at https://discord.com/developers/applications
# 2. Set DISCORD_BOT_TOKEN to your bot token
# 3. Use !station commands in Discord to control the server
# 4. Approve actions via Discord reactions
